# Gmail 계정과 앱 비밀번호(2단계 인증 후 발급한 16자리)
GMAIL_ADDRESS=your_address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 수신자 (쉼표로 구분)
EMAIL_RECIPIENTS=reader1@example.com,reader2@example.com

# Google AI Studio에서 발급
GEMINI_API_KEY=

# 선택: 폰트 경로 직접 지정 (일본어+한국어 모두 포함된 폰트여야 함)
# JAPANESE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
