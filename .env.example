# Gmail 계정과 앱 비밀번호(2단계 인증 후 발급한 16자리)
GMAIL_ADDRESS=your_address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 수신자 (쉼표로 구분)
EMAIL_RECIPIENTS=reader1@example.com,reader2@example.com

# Google AI Studio에서 발급
GEMINI_API_KEY=

# 선택: 특정 카테고리 강제 지정 (테스트용)
# grammar_bank.CATEGORIES의 key와 정확히 일치해야 한다. 아래 다섯 개 외의 값은
# 조용히 무시되고 요일 기준 자동 선택으로 넘어간다(에러가 나지 않으니 주의).
# 부사 / 인용 / 강조·역접 / 비즈니스 / N1문어체
# FORCE_CATEGORY=

# 선택: 폰트 경로 직접 지정 (일본어만 필요, 한국어 라벨 없음)
# JAPANESE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
